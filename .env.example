# 本文件是公开仓库示例配置，请不要填写或提交真实密钥。

# AI 多智能体代码生成系统端口
PORT=8012

# 使用哪一种模型服务：openai / oneapi / ollama
MODEL_TYPE=openai

# OpenAI 兼容接口配置
OPENAI_API_BASE=https://api.example.com/v1
OPENAI_CHAT_API_KEY=your-chat-model-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini

# OneAPI 配置
ONEAPI_API_BASE=http://127.0.0.1:3000/v1
ONEAPI_CHAT_API_KEY=your-oneapi-key
ONEAPI_CHAT_MODEL=qwen-max

# Ollama 本地模型配置
OLLAMA_API_BASE=http://127.0.0.1:11434/v1
OLLAMA_CHAT_API_KEY=NA
OLLAMA_CHAT_MODEL=llama3.1:latest

# 学生信息管理系统端口与数据目录
STUDENT_INFO_PORT=8013
STUDENT_INFO_DATA_DIR=./crewAIWithRag/data
